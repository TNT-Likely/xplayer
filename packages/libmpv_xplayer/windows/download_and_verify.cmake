# Shared by the native build and local integrity regression checks.
function(download_and_verify url sha256 locationForArchive)
  if(EXISTS "${locationForArchive}")
    file(SHA256 "${locationForArchive}" ARCHIVE_SHA256)
    if(sha256 STREQUAL ARCHIVE_SHA256)
      return()
    endif()
    file(REMOVE "${locationForArchive}")
  endif()
  set(TEMPORARY "${locationForArchive}.part")
  foreach(ATTEMPT RANGE 1 3)
    file(DOWNLOAD "${url}" "${TEMPORARY}" TLS_VERIFY ON
      TIMEOUT 120 INACTIVITY_TIMEOUT 20 STATUS DOWNLOAD_STATUS LOG DOWNLOAD_LOG)
    list(GET DOWNLOAD_STATUS 0 DOWNLOAD_CODE)
    if(DOWNLOAD_CODE EQUAL 0)
      file(SHA256 "${TEMPORARY}" ARCHIVE_SHA256)
      if(NOT sha256 STREQUAL ARCHIVE_SHA256)
        file(REMOVE "${TEMPORARY}")
        message(FATAL_ERROR "Native artifact SHA-256 mismatch: ${url}\nExpected: ${sha256}\nReceived: ${ARCHIVE_SHA256}\nUpstream may have replaced the asset. Verify provenance before updating the pin.")
      endif()
      file(RENAME "${TEMPORARY}" "${locationForArchive}")
      return()
    endif()
    file(REMOVE "${TEMPORARY}")
    # Retry interrupted transfers; a missing/revoked asset needs intervention.
    set(RETRYABLE FALSE)
    if(DOWNLOAD_CODE MATCHES "^(7|18|28|35|52|55|56)$" OR
        (DOWNLOAD_CODE EQUAL 22 AND DOWNLOAD_LOG MATCHES "HTTP/[0-9.]+ (429|5[0-9][0-9])"))
      set(RETRYABLE TRUE)
    endif()
    if(ATTEMPT EQUAL 3 OR NOT RETRYABLE)
      message(FATAL_ERROR "Native library download failed: ${DOWNLOAD_STATUS}")
    endif()
    message(STATUS "Native download interrupted; retry ${ATTEMPT}/2")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep "${ATTEMPT}")
  endforeach()
endfunction()
